# ReachFlow AI Outreach Engine Configuration

# Claude AI (Required for dynamic copy variation & spam scoring)
ANTHROPIC_API_KEY=sk-ant-api03-...
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Email Sending Rail (Google Workspace / Gmail / Amazon SES / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@company.com
SMTP_PASS=your-google-app-password
FROM_NAME="Your Name"
FROM_EMAIL=your-email@company.com
REPLY_TO=your-email@company.com

# WhatsApp Sending Rail (Twilio WhatsApp API)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Delivery Safety & Throttling
SEND_DELAY_SECONDS=3
DAILY_LIMIT=500
STOP_ON_HIGH_BOUNCE=true
